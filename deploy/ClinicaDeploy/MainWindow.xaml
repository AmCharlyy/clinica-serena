<Window x:Class="ClinicaDeploy.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clínica Serena · ClinicaDeploy" Width="1360" Height="920" MinWidth="1050" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F4F7F5" Foreground="#183B35">
 <Grid Background="#F4F7F5"><Grid.ColumnDefinitions><ColumnDefinition Width="266"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#103B37"><Grid Margin="28,32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="✳  clínica." FontSize="34" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="S E R E N A" Margin="44,4,0,30" FontSize="10" Foreground="#A4CFC0"/><Border BorderBrush="#31564F" BorderThickness="1" CornerRadius="10" Padding="16"><StackPanel><TextBlock Text="ClinicaDeploy" FontSize="17" Foreground="White" FontWeight="SemiBold"/><TextBlock Text="Asistente del servidor" Foreground="#A4CFC0" Margin="0,5,0,0"/></StackPanel></Border></StackPanel>
   <StackPanel Grid.Row="1" Margin="0,32,0,0"><TextBlock Text="PUESTA EN MARCHA" Foreground="#A4CFC0" FontSize="10" Margin="10,0,0,12"/><ListBox x:Name="Steps" SelectionChanged="StepChanged" Background="Transparent" BorderThickness="0" Foreground="White"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="13,15"/><Setter Property="Margin" Value="0,3"/><Setter Property="Foreground" Value="#DDEDE7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="StepBorder" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="StepBorder" Property="Background" Value="#31594F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle><ListBoxItem Content="01   Bienvenida"/><ListBoxItem Content="02   Requisitos del servidor"/><ListBoxItem Content="03   Configurar clínica"/><ListBoxItem Content="04   Seguridad y continuidad"/><ListBoxItem Content="05   Revisar e instalar"/><ListBoxItem Content="06   Resultado e informe"/></ListBox></StackPanel>
   <StackPanel Grid.Row="3"><Border Height="1" Background="#31564F" Margin="0,0,0,20"/><TextBlock Text="LOCAL. PRIVADO. CONTROLADO." Foreground="#A4CFC0" FontSize="10"/><TextBlock Text="El servidor queda en tus manos.&#x0a;Los datos, dentro de tu clínica." Foreground="#DDEDE7" FontSize="13" Margin="0,12,0,18"/><TextBlock Text="v1.0 · Windows x64" Foreground="#A4CFC0" FontSize="11"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Background="#FAFCFB" BorderBrush="#E4EBE7" BorderThickness="0,0,0,1" Padding="34,0"><DockPanel VerticalAlignment="Center"><TextBlock Text="INSTALACIÓN Y OPERACIÓN" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock x:Name="Privilege" Text="○  Revisión sin elevación" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/><Button Content="Abrir como administrador" Click="Elevate" FontSize="12" Padding="12,8"/></StackPanel></DockPanel></Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="40,30,40,16">
    <TextBlock x:Name="Eyebrow" Text="UN NUEVO COMIENZO" FontSize="10" Foreground="{StaticResource Accent}"/><TextBlock x:Name="Heading" Text="Tu clínica, lista para cuidar." FontSize="32" FontWeight="SemiBold" Margin="0,10,0,8"/><TextBlock x:Name="Subtitle" Text="Un asistente claro para preparar, proteger y mantener tu sistema local." Foreground="{StaticResource Muted}" FontSize="15" Margin="0,0,0,26"/>
    <Grid x:Name="Pages">
     <StackPanel x:Name="Welcome"><Border Style="{StaticResource Card}" Background="#E8F3ED" Padding="30"><StackPanel><TextBlock Text="Todo conectado. Cada cosa en su lugar." FontFamily="Georgia" FontSize="27" Margin="0,0,0,18"/><TextBlock Text="Web clínica + API en IIS, base SQL Server, documentos protegidos y respaldos cifrados. Una sola instalación, sin cuentas de prueba." FontSize="16" LineHeight="26"/><TextBlock Text="El asistente te acompaña; las decisiones sobre DNS, certificados, licencia SQL y acceso de red siguen siendo del técnico responsable." Margin="0,18,0,0" Foreground="{StaticResource Muted}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="¿Qué necesitas hacer?" Style="{StaticResource Section}"/><ComboBox x:Name="Operation" SelectedIndex="0" SelectionChanged="OperationChanged"><ComboBoxItem Content="Instalar una clínica nueva" Tag="Install"/><ComboBoxItem Content="Actualizar una instalación" Tag="Update"/><ComboBoxItem Content="Reparar / volver a publicar" Tag="Repair"/><ComboBoxItem Content="Crear respaldo ahora" Tag="Backup"/><ComboBoxItem Content="Recuperar una copia aislada" Tag="Restore"/><ComboBoxItem Content="Diagnóstico, sin cambios" Tag="Diagnostics"/><ComboBoxItem Content="Exportar clave de recuperación" Tag="ExportKey"/></ComboBox><WrapPanel><Button Content="Importar configuración" Click="ImportConfig"/><Button Content="Guardar configuración" Click="ExportConfig" Background="#E8F3ED" Foreground="#183B35"/></WrapPanel><TextBlock Text="Las contraseñas no se exportan. Para una instalación existente, importa state\config.json y elige después la operación." Margin="0,16,0,0" Foreground="{StaticResource Muted}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Antes de empezar" Style="{StaticResource Section}"/><TextBlock Text="Windows Server 2019 o posterior, IIS, Hosting Bundle .NET 10 x64 y una instancia SQL local. HTTPS necesita un certificado confiable y DNS resuelto en la red. SSMS es opcional para el técnico." LineHeight="24"/><TextBlock Text="No se cambian RDP, antivirus ni sitios ajenos. No se instala el motor SQL ni se habilitan correo o registros públicos de pacientes." Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="Requirements" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Primero, una revisión de solo lectura" Style="{StaticResource Section}"/><TextBlock Text="Completa instancia SQL, DNS y certificado en los siguientes pasos y vuelve aquí. Revisar no cambia el servidor." Margin="0,0,0,18"/><WrapPanel><Button Content="Revisar servidor" Click="CheckServer"/><Button Content="Preparar IIS…" Click="EnableIis" Background="#E8F3ED" Foreground="#183B35"/><Button Content="Hosting Bundle oficial…" Click="InstallHosting" Background="#E8F3ED" Foreground="#183B35"/></WrapPanel><TextBlock Text="IIS y Hosting Bundle requieren elevación y confirmación explícita. Si requieren reinicio, se informa sin reiniciar otros servicios automáticamente." Foreground="{StaticResource Muted}" Margin="0,18,0,0"/><ItemsControl x:Name="CheckItems" Margin="0,20,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E4EBE7" BorderThickness="0,0,0,1" Padding="0,14"><StackPanel><TextBlock><Run Text="{Binding Status}"/><Run Text="  ·  "/><Run Text="{Binding Name}"/></TextBlock><TextBlock Text="{Binding Detail}" Foreground="#6E807B" Margin="0,6,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></StackPanel>
     <StackPanel x:Name="Configuration" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Publicación del sistema" Style="{StaticResource Section}"/><TextBlock Text="Paquete ZIP de Clínica Serena"/><DockPanel><Button DockPanel.Dock="Right" Content="Elegir…" Click="ChoosePackage" Margin="8,6,0,16"/><TextBox x:Name="PackageBox"/></DockPanel><TextBlock Text="SHA-256 esperado · desde el archivo SHA256SUMS de confianza"/><TextBox x:Name="HashBox"/><UniformGrid Columns="2"><StackPanel Margin="0,0,12,0"><TextBlock Text="Nombre DNS interno"/><TextBox x:Name="HostBox" Text="clinica.interna.example"/></StackPanel><StackPanel><TextBlock Text="Puerto HTTPS"/><TextBox x:Name="PortBox" Text="443"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Sitio IIS"/><TextBox x:Name="SiteBox" Text="ClinicaSerena"/></StackPanel><StackPanel><TextBlock Text="Pool / identidad IIS"/><TextBox x:Name="PoolBox" Text="ClinicaSerena"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Instancia SQL local"/><TextBox x:Name="SqlBox" Text="localhost\SQLEXPRESS"/></StackPanel><StackPanel><TextBlock Text="Nombre de base de datos"/><TextBox x:Name="DatabaseBox" Text="ClinicaDB"/></StackPanel></UniformGrid><TextBlock Text="SQL usa autenticación Windows y memoria compartida local. El técnico realiza migraciones; la web no recibe db_owner ni permisos de restauración." Foreground="{StaticResource Muted}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Datos reales de la clínica" Style="{StaticResource Section}"/><TextBlock Text="Nombre de clínica"/><TextBox x:Name="ClinicBox" Text="Clínica Serena"/><TextBlock Text="Domicilio"/><TextBox x:Name="AddressBox"/><UniformGrid Columns="2"><StackPanel Margin="0,0,12,0"><TextBlock Text="Teléfono"/><TextBox x:Name="PhoneBox"/></StackPanel><StackPanel><TextBlock Text="Correo de contacto (no habilita envíos)"/><TextBox x:Name="EmailBox"/></StackPanel></UniformGrid></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Carpetas separadas" Style="{StaticResource Section}"/><TextBlock Text="Programa y versiones"/><TextBox x:Name="RootBox" Text="C:\ClinicaSerena"/><TextBlock Text="Documentos y claves"/><TextBox x:Name="DataBox" Text="C:\ClinicaSerenaData"/><TextBlock Text="Respaldos cifrados (idealmente otro disco)"/><TextBox x:Name="BackupBox" Text="C:\ClinicaSerenaBackups"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="Security" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Identidad, HTTPS y permisos mínimos" Style="{StaticResource Section}"/><TextBlock Text="Certificado TLS instalado en Equipo local / Personal (huella SHA-1)"/><TextBox x:Name="TlsBox"/><Button Content="Ver certificados disponibles" Click="ListCertificates" HorizontalAlignment="Left" Background="#E8F3ED" Foreground="#183B35"/><TextBlock x:Name="Certificates" Foreground="{StaticResource Muted}" Margin="0,12,0,16"/><UniformGrid Columns="2"><StackPanel Margin="0,0,12,0"><TextBlock Text="Usuario inicial"/><TextBox x:Name="AdminUserBox" Text="admin"/></StackPanel><StackPanel><TextBlock Text="Nombre del responsable"/><TextBox x:Name="AdminNameBox"/></StackPanel><StackPanel Margin="0,0,12,0"><TextBlock Text="Correo del responsable"/><TextBox x:Name="AdminEmailBox"/></StackPanel><StackPanel><TextBlock Text="Contraseña inicial · mínimo 15 caracteres"/><PasswordBox x:Name="AdminPassword"/></StackPanel></UniformGrid><TextBlock Text="Solo para instalación nueva. No crea pacientes ni personal ficticio. Al entrar, el administrador cambia contraseña y configura TOTP obligatorio." Foreground="{StaticResource Muted}" Margin="0,0,0,16"/><CheckBox x:Name="FirewallCheck" IsChecked="True" Content="Crear regla HTTPS para la clínica (perfiles Privado y Dominio)"/><TextBlock Text="Red permitida · LocalSubnet o IPv4/CIDR separados por coma"/><TextBox x:Name="ScopeBox" Text="LocalSubnet"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Continuidad y recuperación" Style="{StaticResource Section}"/><CheckBox x:Name="ScheduleCheck" IsChecked="True" Content="Programar respaldo diario cifrado como SYSTEM"/><TextBlock Text="Hora local del servidor · HH:mm"/><TextBox x:Name="TimeBox" Text="02:00" Width="140" HorizontalAlignment="Left"/><CheckBox x:Name="CustodyCheck" Content="Custodiaré la clave PFX fuera del servidor y probaré la restauración"/><CheckBox x:Name="MaintenanceCheck" Content="Autorizo una ventana de mantenimiento para esta operación"/><TextBlock Text="Contraseña para exportar clave PFX · mínimo 15 caracteres (solo Exportar clave)"/><PasswordBox x:Name="ExportPassword"/><TextBlock Text="Nunca se reinicia toda la máquina ni se borra un respaldo por antigüedad. La tarea detiene temporalmente solo la clínica para copiar datos coherentes." Foreground="{StaticResource Muted}"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Recuperación aislada · solo si elegiste Recuperar" Style="{StaticResource Section}"/><TextBlock Text="Archivo de respaldo .serena"/><DockPanel><Button DockPanel.Dock="Right" Content="Elegir…" Click="ChooseBackup" Margin="8,6,0,16"/><TextBox x:Name="RecoveryFileBox"/></DockPanel><TextBlock Text="Base NUEVA de recuperación"/><TextBox x:Name="RecoveryDbBox" Text="ClinicaDB_Recuperacion"/><TextBlock Text="Carpeta NUEVA de recuperación"/><TextBox x:Name="RecoveryPathBox" Text="C:\ClinicaSerenaRecovery"/><TextBlock Text="Huella de la clave importada para recuperar en otro servidor"/><TextBox x:Name="RecoveryKeyBox"/><Button Content="Importar clave PFX de recuperación…" Click="ImportRecoveryKey" HorizontalAlignment="Left" Background="#E8F3ED" Foreground="#183B35"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="Review" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Este es el alcance de la operación" Style="{StaticResource Section}"/><Border Background="#E8F3ED" CornerRadius="10" Padding="18" Margin="0,0,0,20"><TextBlock x:Name="ReviewSummary" LineHeight="25"/></Border><TextBlock x:Name="PlanText" LineHeight="27"/><Border Background="#FFF5E5" CornerRadius="10" Padding="18" Margin="0,20,0,0"><TextBlock Text="La revisión no garantiza una instalación certificada. No cierres el asistente durante migraciones. Si falla una actualización después de migrar, el sitio queda en mantenimiento: no se deshacen cambios SQL automáticamente."/></Border><CheckBox x:Name="ConfirmCheck" Content="He revisado la configuración, el alcance y las advertencias" Margin="0,22,0,0"/></StackPanel></Border></StackPanel>
     <StackPanel x:Name="Results" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock x:Name="ResultTitle" Text="Todavía no se ejecutó una operación" Style="{StaticResource Section}"/><ProgressBar x:Name="Progress" Height="5" Foreground="#087F79" IsIndeterminate="False" Margin="0,0,0,20"/><TextBlock x:Name="ResultMessage" Text="Aquí verás cada comprobación, el resultado y el informe técnico." Foreground="{StaticResource Muted}"/><TextBox x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="260" FontFamily="Consolas" FontSize="12" Background="#F4F7F5" Margin="0,20,0,20"/><WrapPanel><Button Content="Abrir informes" Click="OpenReports"/><Button Content="Abrir clínica" Click="OpenClinic" Background="#E8F3ED" Foreground="#183B35"/></WrapPanel></StackPanel></Border><Border Style="{StaticResource Card}" Background="#E8F3ED"><StackPanel><TextBlock Text="Entrega responsable" Style="{StaticResource Section}"/><TextBlock Text="Exporta y custodia la clave de recuperación. Comprueba DNS y confianza HTTPS desde los equipos de la clínica. Prueba una restauración aislada, el primer acceso con TOTP y los permisos por rol. Mantén Windows actualizado y una copia de respaldo fuera de este servidor." LineHeight="25"/></StackPanel></Border></StackPanel>
    </Grid>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="2" Background="White" BorderBrush="#E4EBE7" BorderThickness="0,1,0,0" Padding="32,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="FooterText" Text="Tus datos no salen del servidor por usar este asistente." FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BackButton" Content="Anterior" Click="Back" Background="#E8F3ED" Foreground="#183B35"/><Button x:Name="NextButton" Content="Comenzar  →" Click="Next"/></StackPanel></Grid></Border>
  </Grid>
 </Grid>
</Window>
